# ── BB Medical environment ───────────────────────────────────────────
# Copy to .env.local for local dev, and set the same keys in Vercel.

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SB_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings → API → anon public)
NEXT_PUBLIC_SB_ANON_KEY=your-anon-public-key

# Password that unlocks the /console admin area (client-side gate)
NEXT_PUBLIC_CONSOLE_KEY=choose-a-strong-passphrase

# Canonical site origin — used for metadata / OG URLs
NEXT_PUBLIC_SITE_ORIGIN=https://bbmedical.co
